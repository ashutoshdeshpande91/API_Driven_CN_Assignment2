# Copy to .env and fill in. Never commit .env.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx
# Any chat model your HF account can call via the Inference API (check availability on huggingface.co):
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional: use any OpenAI-compatible chat API instead of Hugging Face (all three must be set):
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=your_key_here
# LLM_MODEL=model-name-from-your-provider

# Shortcut for Google Gemini (uses GEMINI_API_KEY or GOOGLE_API_KEY from your environment):
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.6-flash
# LLM_REASONING_EFFORT=none   # optional; stops the model spending the answer budget on thinking
